<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tg_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/tg_surface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textColor="@color/tg_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbThemeSystem"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="System default" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbThemeLight"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Light" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbThemeDark"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Dark" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Alarm Behaviour"
                android:textColor="@color/tg_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAlarmSound"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Play alarm sound" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchVibration"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Vibrate on alert" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchRepeatAlarm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Repeat alarm until I'm Awake" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Permissions &amp; Battery"
                android:textColor="@color/tg_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermissionSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/tg_on_surface_variant"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAppSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Open Android App Permissions &amp; Battery Settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Privacy &amp; Open-Source Attribution"
                android:textColor="@color/tg_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrivacyAttribution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="TravelGuard keeps all location and destination data locally on your device. No analytics, ads, or location tracking servers are used.\n\n• Map rendering: osmdroid (Apache-2.0) &amp; OpenStreetMap contributors (ODbL)\n• Place search: Nominatim (OpenStreetMap)\n• Routing: OSRM (BSD-2-Clause)\n• Note: TravelGuard is a passenger convenience aid and not a certified emergency or life-safety device."
                android:textColor="@color/tg_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
